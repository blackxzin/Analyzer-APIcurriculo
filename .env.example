# Copie para .env e ajuste. O arquivo .env NUNCA vai para o git.

# --- Banco de dados ---
DB_NAME=cvanalyzer
DB_USERNAME=cvanalyzer
DB_PASSWORD=troque-esta-senha
DB_PORT=5433

# --- Autenticacao ---
# Minimo de 32 caracteres. Gere um proprio, nao reaproveite este:
#   openssl rand -base64 48
JWT_SECRET=troque-este-segredo-por-um-gerado-com-openssl-rand
JWT_EXPIRATION=1h

# --- Aplicacao rodando fora do Docker (IDE / mvnw) ---
DB_URL=jdbc:postgresql://localhost:5433/cvanalyzer
SERVER_PORT=8080

# --- Aplicacao rodando dentro do Docker (perfil "full") ---
API_PORT=8080
